
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADA
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  tareas    Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id               Int        @id @default(autoincrement())
  titulo           String
  descripcion      String?
  fecha_vencimiento DateTime?
  estado           TaskStatus @default(PENDIENTE)
  userId            Int
  usuario           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId])
}
